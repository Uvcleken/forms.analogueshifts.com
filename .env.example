# =============================================================================
# Custom Node.js Server Configuration
# Used when running the app via `npm run server` (server.ts custom server)
# =============================================================================

# Port the custom server listens on (default: 3000)
NODE_PORT='3000'

# Node environment: 'development' | 'production' | 'test'
NODE_ENV='production'

# Hostname the custom server binds to (default: localhost)
NODE_HOSTNAME='localhost'

# =============================================================================
# Next.js Public Environment Variables
# All NEXT_PUBLIC_* variables are exposed to the browser bundle
# =============================================================================

# Base URL of the backend API (e.g. https://api.example.com)
NEXT_PUBLIC_BACKEND_URL=

# Base URL of the WordPress site used for blog/CMS content
NEXT_PUBLIC_WORDPRESS_URL=

# =============================================================================
# Mail Configuration
# Used for transactional email sending
# =============================================================================

# Mail service provider name (e.g. smtp, sendgrid, mailgun)
NEXT_PUBLIC_MAIL_SERVICE=

# SMTP host address (e.g. smtp.mailtrap.io)
NEXT_PUBLIC_MAIL_HOST=

# SMTP port (e.g. 587 for TLS, 465 for SSL, 25 for plain)
NEXT_PUBLIC_MAIL_PORT=

# SMTP authentication username / API key
NEXT_PUBLIC_MAIL_USERNAME=

# SMTP authentication password / API secret
NEXT_PUBLIC_MAIL_PASSWORD=

# Encryption method: 'tls' | 'ssl' | 'none'
NEXT_PUBLIC_MAIL_ENCRYPTION=

# From address used in outgoing emails (e.g. no-reply@example.com)
NEXT_PUBLIC_MAIL_FROM_ADDRESS=

# Display name used in the From header of outgoing emails
NEXT_PUBLIC_MAIL_FROM_NAME=

# =============================================================================
# Third-Party API Keys
# =============================================================================

# OpenAI API key for AI-powered features
NEXT_PUBLIC_OPENAI_API_KEY=

# Flutterwave public key for payment processing
NEXT_PUBLIC_FLUTTERWAVE_KEY=

# Application secret key (used for signing/encryption)
NEXT_PUBLIC_SECRET_KEY=

# Application public key
NEXT_PUBLIC_PUBLIC_KEY=
